APP_NAME="MarketLens Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marketlens_platform
DB_USERNAME=marketlens
DB_PASSWORD=

TEST_DB_CONNECTION=pgsql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=marketlens_platform_test
TEST_DB_USERNAME=marketlens
TEST_DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=database
BROADCAST_CONNECTION=reverb

SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

FILESYSTEM_DISK=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=marketlens-development
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE_ENDPOINT=true

SYNC_INGRESS_ENABLED=true
SYNC_INGRESS_RATE_LIMIT_PER_MINUTE=120
MONITORING_API_BASE_URL=http://localhost:8000/api
