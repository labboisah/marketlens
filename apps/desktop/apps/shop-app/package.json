{
  "name": "@marketlens/shop-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b && vite build --config vite.renderer.config.ts",
    "clean": "rimraf dist coverage out .vite",
    "dev": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "lint": "eslint .",
    "make": "electron-forge make",
    "package": "electron-forge package",
    "rebuild:native": "electron-rebuild",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@marketlens/api-contracts": "file:../../packages/api-contracts",
    "@marketlens/calculations": "file:../../packages/calculations",
    "@marketlens/permissions": "file:../../packages/permissions",
    "@marketlens/shared-types": "file:../../packages/shared-types",
    "@marketlens/sync-contracts": "file:../../packages/sync-contracts",
    "@marketlens/ui": "file:../../packages/ui",
    "@marketlens/validation": "file:../../packages/validation",
    "better-sqlite3": "latest",
    "argon2": "latest",
    "jsonwebtoken": "latest",
    "dotenv": "latest",
    "drizzle-orm": "latest",
    "fastify": "latest",
    "pino": "latest",
    "react": "latest",
    "react-dom": "latest",
    "socket.io": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@electron-forge/plugin-vite": "latest",
    "@electron-forge/cli": "latest",
    "@electron-forge/maker-squirrel": "latest",
    "@electron-forge/maker-zip": "latest",
    "@electron-forge/shared-types": "latest",
    "@electron/rebuild": "latest",
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "electron": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
