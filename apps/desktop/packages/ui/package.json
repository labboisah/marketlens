{
  "name": "@marketlens/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/tokens.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset": "./src/tailwind-preset.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist coverage",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "echo \"No e2e tests for ui\"",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "clsx": "latest",
    "lucide-react": "latest",
    "tailwind-merge": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "typescript": "latest"
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.0"
  }
}
